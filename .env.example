# Copy to .env and fill in your keys:  cp .env.example .env

# ---- LLM provider ----
LLM_PROVIDER=anthropic              # anthropic | google_genai
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=                     # from Google AI Studio
TAVILY_API_KEY=                     # Tavily free tier

# ---- Role -> model mapping ----
ANTHROPIC_INTERVIEWER_MODEL=claude-sonnet-5-5
ANTHROPIC_EVALUATOR_MODEL=claude-sonnet-5-5
ANTHROPIC_FEEDBACK_MODEL=claude-opus-5-5
GEMINI_INTERVIEWER_MODEL=gemini-2.5-flash
GEMINI_EVALUATOR_MODEL=gemini-2.5-flash
GEMINI_FEEDBACK_MODEL=gemini-2.5-flash   # use a Pro model if your quota allows
# Same-provider fallbacks (comma-separated) used on 503 'high demand' / 429 quota errors
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
ANTHROPIC_FALLBACK_MODELS=

# ---- Voice ----
STT_ENGINE=mlx_whisper              # mlx_whisper | faster_whisper | gemini
WHISPER_MODEL=mlx-community/whisper-small.en-mlx
TTS_VOICE=en-US-GuyNeural

# ---- Interview defaults ----
NUM_QUESTIONS=10
ANSWER_TIME_LIMIT_SEC=180
CODING_TIME_LIMIT_SEC=1200
FEEDBACK_MODE=practice              # practice | realistic
MAX_FOLLOW_UPS=2

# ---- Coding ----
CODE_RUN_TIMEOUT_SEC=5
CODE_MEMORY_LIMIT_MB=512

# ---- Storage ----
DATA_DIR=data/runtime
